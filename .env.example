# SpendPilot AI — environment variables
# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored and NEVER committed.

# ── Anthropic ─────────────────────────────────────────────────────────────────
# Get your key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Optional overrides ────────────────────────────────────────────────────────
# Override the Claude model used for audit summaries (default: claude-haiku-4-5)
# ANTHROPIC_SUMMARY_MODEL=claude-haiku-4-5

# ── Supabase ──────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → your project → Settings → API
#
# NEXT_PUBLIC_* vars are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service-role key — server-side ONLY. Never expose to the browser.
# Used by API routes to bypass RLS for trusted writes.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Resend ────────────────────────────────────────────────────────────────────
# Get your key at https://resend.com/api-keys
RESEND_API_KEY=re_JzzDTm8Y_9Edya8qAdUKm3radgkmEu75d
